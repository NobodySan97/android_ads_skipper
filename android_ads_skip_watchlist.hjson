{
  ad_skip_buttons_xpath: 
    '''
    fn:reverse((.//*[@android:clickable='true' and @android:enabled='true' and ((fn:matches(@android:contentDescription|@android:text[not(../@android:editable='true')], "^(Skip ads?|Salta annunci?|(Saltar|Omitir) anuncios?|Pular anúncios?|(Pass|Ignor)er l(es |'| )annonces?|Werbung(en)? überspringen|Close ad( panel)?|Chiudi annuncio|Cerrar anuncio|Fechar anúncio|Werbung schließen|Fermer l'annonce|略過廣告|關閉廣告|跳过广告|关闭广告|広告をスキップ|広告を閉じる|광고 건너뛰기|광고 닫기|Пропустить( рекламу)?|Закрыть рекламу|.*(Button to collapse the message|collapse the message).*|(NO THANKS|No thanks|Non merci|No gracias|No, grazie|Not now|Non ora|Jetzt nicht|Agora não))$")) or (fn:matches(@android:id, '^@(com.google.android.apps.youtube.music:id/dismiss(_button)?|com.google.android.apps.youtube.music:id/secondary_action|.*:id/banderol_close|.*:id/(modern_)?skip_ad(_button)?(_text|_container)?|.*:id/player_overlay_modern_skip_ad_button|.*:id/ad_dismiss(_button)?|.*:id/(btn|iv|ib|img)_close(_ad)?|.*:id/(al_close_button|applovin_interstitial_close_button|unity_ads_close_button|unity_ads_skip|tt_video_ad_close|mbridge_native_ec_close|(is|isa)_close_button|vungle_close_button)|com.google.android.youtube:id/hide_controls_button_top|close(_video)?_button|.*:id/go_premium_button_continue_with_ads|.*:id/(close|rateDialog.*Cancel))$')))])[1]/ancestor-or-self::*)
    ''',
  ad_playing_indicators_xpath: 
    '''
    fn:reverse((.//*[@android:enabled='true' and ((fn:matches(@android:contentDescription|@android:text[not(../@android:editable='true')], "^(Visit advertiser|Visita (il sito dell')?inserzionista|Visitar anunciante|Visiter le site de l'annonceur|Webseite des Werbetreibenden besuchen|Video will play after ad|Il video inizierà dopo l'annuncio|El video se reproducirá después del anuncio)$")) or (fn:matches(@android:id, '^@(gmsg-video-player|performance_video_container|count-down|com.google.android.apps.youtube.music:id/player_learn_more_button|com.google.android.youtube:id/countdown_text|.*:id/ad_(progress_text|countdown)|.*:id/app_promo_ad_cta_overlay|.*:id/(tt_reward_full_count_down|al_html_view|unity_ads_count_down))$')))])[1]/ancestor-or-self::*)
    ''',
  xpaths_parse_successful: ["true"]
}
